# =============================================================================
# Meeting Scribe — template de ambiente
#
# Como usar (PowerShell):
#   copy .env.template .env
#
# Depois rode:
#   npm run dev
#   ou
#   docker compose up --build
#
# Não edite o .env.template para segredos — só o .env (que não vai pro Git).
# =============================================================================

# -----------------------------------------------------------------------------
# URLs dos apps (mesmo host local)
# -----------------------------------------------------------------------------
PORT=3001
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
MEETING_SCRIBE_API_URL=http://localhost:3001

# SSR do Next: local = localhost; no Docker Compose o compose sobrescreve para http://backend:3001
API_INTERNAL_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Banco (Prisma / SQLite)
# npm run dev  → arquivo local no backend
# Docker       → o compose sobrescreve para file:./data/prod.db
# -----------------------------------------------------------------------------
DATABASE_URL=file:./dev.db

# -----------------------------------------------------------------------------
# Transcrição (STT)
# local  = Whisper embutido no Node (padrão, zero config)
# Se usar só Docker Compose, o backend já aponta para o serviço whisper
# -----------------------------------------------------------------------------
STT_PROVIDER=local
STT_LOCAL_MODEL=Xenova/whisper-tiny
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# -----------------------------------------------------------------------------
# Detecção de reuniões (alerta antes / na hora)
# -----------------------------------------------------------------------------
MEETING_ALERT_MINUTES=3
MEETING_ALERT_GRACE_MINUTES=5

# -----------------------------------------------------------------------------
# Servidor Linux / produção — use o IP ou domínio do host
# Local: deixe localhost. No servidor, troque e rode docker compose up --build
# -----------------------------------------------------------------------------
# CORS_ORIGIN=http://SEU_IP:3000
# NEXT_PUBLIC_API_URL=http://SEU_IP:3001
# NEXT_PUBLIC_WS_URL=http://SEU_IP:3001
FRONTEND_PORT=3000
BACKEND_PORT=3001
WHISPER_PORT=8080

# -----------------------------------------------------------------------------
# OAuth Google Calendar — GRÁTIS (recomendado para Meet automático)
# Setup: docs/oauth-setup-gratis.md
# Depois: Calendários → Conectar Google → aceitar permissões
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/calendar/google/callback

# -----------------------------------------------------------------------------
# OAuth Microsoft / Outlook / Teams — GRÁTIS
# Setup: docs/oauth-setup-gratis.md
# Depois: Calendários → Conectar Outlook / Teams → aceitar permissões
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/v1/calendar/microsoft/callback
MICROSOFT_TENANT=common

# Links ICS — só se não puder usar OAuth (alternativa)
CALENDAR_ICS_URLS=
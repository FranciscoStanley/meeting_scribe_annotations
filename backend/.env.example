DATABASE_URL="file:./dev.db"
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Transcrição local embutida (zero config). Alternativa: Docker Whisper.
STT_PROVIDER=local
STT_LOCAL_MODEL=Xenova/whisper-tiny
# STT_BASE_URL=http://localhost:8080/v1
STT_API_KEY=
STT_MODEL=whisper-1

MEETING_ALERT_MINUTES=3

# Feeds ICS opcionais (separados por vírgula) — sem OAuth
CALENDAR_ICS_URLS=

# OAuth opcional (só se quiser Google/Microsoft oficiais)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/calendar/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/v1/calendar/microsoft/callback
MICROSOFT_TENANT=common

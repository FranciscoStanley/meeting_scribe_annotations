DATABASE_URL="file:./dev.db"
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Transcrição: OpenAI-compatible Whisper (local faster-whisper, Groq, etc.)
STT_BASE_URL=http://localhost:8080/v1
STT_API_KEY=
STT_MODEL=whisper-1

# Detecção de reuniões (minutos antes para alertar)
MEETING_ALERT_MINUTES=3
MEETING_POLL_CRON=* * * * *

# Google Calendar OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/calendar/google/callback

# Microsoft Graph OAuth (opcional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/v1/calendar/microsoft/callback
MICROSOFT_TENANT=common

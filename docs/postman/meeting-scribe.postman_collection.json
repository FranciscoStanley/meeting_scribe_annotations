{
  "info": {
    "name": "Meeting Scribe API",
    "description": "Collection HTTP do backend NestJS — manter sincronizada com Swagger (/api/docs) e docs/realtime.md (WebSocket).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "meetingId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "description": "Healthcheck do NestJS."
      }
    },
    {
      "name": "Meetings",
      "item": [
        {
          "name": "List meetings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/meetings",
            "description": "Lista sessões com segmentCount."
          }
        },
        {
          "name": "Create meeting (Meet)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Teste Google Meet\",\n  \"scheduledStart\": \"2026-09-22T18:00:00.000Z\",\n  \"scheduledEnd\": \"2026-09-22T18:30:00.000Z\",\n  \"joinUrl\": \"https://meet.google.com/rdg-sxjm-eux\",\n  \"platform\": \"MEET\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/meetings",
            "description": "Agenda reunião. joinUrl é obrigatório. Alerta SSE na janela MEETING_ALERT_MINUTES / MEETING_ALERT_GRACE_MINUTES."
          }
        },
        {
          "name": "Create meeting (Teams)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Daily Teams\",\n  \"scheduledStart\": \"2026-09-22T18:00:00.000Z\",\n  \"joinUrl\": \"https://teams.microsoft.com/meet/237776367551390?p=xxx\",\n  \"platform\": \"TEAMS\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/meetings"
          }
        },
        {
          "name": "Sync calendar",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/meetings/sync-calendar",
            "description": "Sincroniza feeds ICS + contas OAuth conectadas."
          }
        },
        {
          "name": "Get transcript",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/meetings/{{meetingId}}/transcript",
            "description": "Trechos salvos com speakerLabel."
          }
        },
        {
          "name": "Start session",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/meetings/{{meetingId}}/start",
            "description": "Marca sessão LIVE antes/durante a captura WebSocket."
          }
        },
        {
          "name": "Complete session",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/meetings/{{meetingId}}/complete"
          }
        }
      ]
    },
    {
      "name": "Calendar OAuth",
      "item": [
        {
          "name": "Status (configured + accounts)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/calendar/status"
          }
        },
        {
          "name": "Connect Google (browser redirect)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/calendar/google/connect"
          }
        },
        {
          "name": "Connect Microsoft (browser redirect)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/calendar/microsoft/connect"
          }
        },
        {
          "name": "Disconnect account",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/calendar/accounts/{{accountId}}"
          }
        }
      ]
    },
    {
      "name": "Calendar feeds (ICS)",
      "item": [
        {
          "name": "List feeds",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/calendar/feeds"
          }
        },
        {
          "name": "Add feed",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://calendar.google.com/calendar/ical/exemplo/private-xxx/basic.ics\",\n  \"label\": \"Trabalho\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/calendar/feeds"
          }
        },
        {
          "name": "Remove feed",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/calendar/feeds/{{feedId}}"
          }
        }
      ]
    },
    {
      "name": "Events SSE",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/events/stream",
        "description": "Server-Sent Events.\n\nTipos:\n- meeting:starting — { sessionId, title, platform, joinUrl, startsInMinutes }\n- heartbeat — { at }\n\nEnv: MEETING_ALERT_MINUTES (lead), MEETING_ALERT_GRACE_MINUTES (atraso do cron)."
      }
    },
    {
      "name": "WebSocket /transcription (docs)",
      "item": [
        {
          "name": "Protocolo Socket.IO",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/docs",
            "description": "Não é HTTP — use Socket.IO no namespace /transcription (NEXT_PUBLIC_WS_URL).\n\nClient → Server:\n- session:start | session:subscribe { sessionId }\n- audio:chunk { sessionId, mimeType, data base64 }\n- session:complete { sessionId }\n\nServer → Client:\n- transcript:segment { id, speakerLabel, text, startedAt, confidence }\n\nRoom: session:{sessionId}. Ver docs/realtime.md."
          }
        }
      ]
    }
  ]
}
